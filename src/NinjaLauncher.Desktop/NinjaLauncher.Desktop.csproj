<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NinjaLauncher</AssemblyName>
    <RootNamespace>NinjaLauncher.Desktop</RootNamespace>
    <ApplicationIcon>Assets\ninja-launcher.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="NinjaLauncher.Localization.%(Filename).json" />
    <!-- Private, git-ignored: the server pre-listed in Multiplayer (see Services/ListedServer.cs). -->
    <EmbeddedResource Include="listed-server.json" LogicalName="NinjaLauncher.listed-server.json" Condition="Exists('listed-server.json')" />
    <!-- Private, git-ignored (*.key): the CurseForge key built into release builds (see Services/BuiltInKeys.cs). -->
    <EmbeddedResource Include="curseforge-api.key" LogicalName="NinjaLauncher.curseforge-api.key" Condition="Exists('curseforge-api.key')" />
    <!-- The owner's update-feed public key. Without it, self-update stays disabled (see docs/releases/RELEASING.md). -->
    <EmbeddedResource Include="..\..\branding\update-signing-key.pub.pem" LogicalName="NinjaLauncher.UpdateSigningKey.pem"
                      Condition="Exists('..\..\branding\update-signing-key.pub.pem')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NinjaLauncher.Infrastructure\NinjaLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\NinjaLauncher.Platform\NinjaLauncher.Platform.csproj" />
    <ProjectReference Include="..\NinjaLauncher.Minecraft.Java\NinjaLauncher.Minecraft.Java.csproj" />
    <ProjectReference Include="..\NinjaLauncher.Mods\NinjaLauncher.Mods.csproj" />
  </ItemGroup>
</Project>
