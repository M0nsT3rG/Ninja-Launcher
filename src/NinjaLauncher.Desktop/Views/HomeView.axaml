<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NinjaLauncher.Desktop.Localization"
             xmlns:vm="using:NinjaLauncher.Desktop.ViewModels"
             xmlns:d="using:NinjaLauncher.Domain"
             xmlns:l="using:NinjaLauncher.Minecraft.Java.Launch"
             xmlns:n="using:NinjaLauncher.Infrastructure.News"
             xmlns:v="using:NinjaLauncher.Desktop.Views"
             xmlns:c="using:NinjaLauncher.Desktop.Controls"
             x:Class="NinjaLauncher.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel" Classes="page">
  <UserControl.Styles>
    <!-- Java / Bedrock switch: two pills, the chosen one filled with the accent gradient. -->
    <Style Selector="RadioButton.edition">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="pill" Background="{DynamicResource NinjaSurfaceRaised}" BorderBrush="{DynamicResource NinjaBorder}" BorderThickness="1"
                  CornerRadius="10" Padding="22,8">
            <ContentPresenter Content="{TemplateBinding Content}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.edition:checked /template/ Border#pill">
      <Setter Property="Background" Value="{DynamicResource NinjaGradient}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="RadioButton.edition:checked /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.edition:focus-visible /template/ Border#pill">
      <Setter Property="BorderBrush" Value="{DynamicResource NinjaAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.news">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.news:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NinjaSurfaceRaised}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,360" RowDefinitions="Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
      <RadioButton Classes="edition" GroupName="edition" Content="Java" IsChecked="{Binding IsJava}" />
      <RadioButton Classes="edition" GroupName="edition" Content="Bedrock" IsChecked="{Binding IsBedrock, Mode=OneWay}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,0,18,0">
      <StackPanel Spacing="16">
        <!-- Character card -->
        <Border Height="330" CornerRadius="18" ClipToBounds="True" BorderBrush="{DynamicResource NinjaBorder}" BorderThickness="1">
          <Grid>
            <c:PixelScene Seed="1312" Time="Sunset" />
            <Image Source="{Binding Background}" Stretch="UniformToFill" IsVisible="{Binding HasCustomBackground}" />
            <Border Height="110" VerticalAlignment="Bottom">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="#000E0A16" />
                  <GradientStop Offset="1" Color="#CC0E0A16" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <c:SkinView Skin="{Binding Skin}" Cape="{Binding Cape}" Slim="{Binding Slim}" Margin="0,64,0,60"
                        AutomationProperties.Name="{loc:T 'Your character. Drag or use the arrow keys to turn it.'}" />

            <Button HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Padding="16,6" Command="{Binding OpenWardrobeCommand}"
                    Background="#B30E0A16" BorderBrush="#33FFFFFF" BorderThickness="1" ToolTip.Tip="{loc:T 'Change your skin and cape'}">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding PlayerName}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:T '→ Open wardrobe'}" FontSize="11" Foreground="#E9D5FF" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" MinWidth="260" HorizontalAlignment="Center"
                      VerticalAlignment="Bottom" Margin="0,0,0,14" PlaceholderText="{loc:T 'Sign in on the Accounts page'}"
                      AutomationProperties.Name="{loc:T 'Account'}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="d:MinecraftAccount">
                  <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14" Padding="9" Command="{Binding EditBackgroundCommand}"
                    Background="#B30E0A16" ToolTip.Tip="{loc:T 'Change the background'}" AutomationProperties.Name="{loc:T 'Change the background'}">
              <PathIcon Width="16" Height="16" Foreground="White"
                        Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" />
            </Button>
          </Grid>
        </Border>

        <!-- Java: recent instances -->
        <StackPanel Spacing="10" IsVisible="{Binding IsJava}">
          <TextBlock Classes="h2" Text="{loc:T 'Last played'}" />
          <TextBlock Classes="muted" Text="{loc:T 'Create a profile in Profiles to start playing.'}" IsVisible="{Binding HasNoRecent}" />
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="d:GameInstance">
                <Border Classes="card" Padding="12" Margin="0,0,0,8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="accent" Content="{loc:T '▶ Play'}" Padding="22,8"
                              Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PlayCommand}" CommandParameter="{Binding}" />
                      <Button Padding="9" ToolTip.Tip="{loc:T 'Profile settings'}" AutomationProperties.Name="{loc:T 'Profile settings'}"
                              Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenInstanceCommand}" CommandParameter="{Binding}">
                        <PathIcon Width="16" Height="16" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                      </Button>
                    </StackPanel>
                    <Image DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0" c:RemoteImage.Url="{Binding Converter={x:Static v:Converters.InstanceIcon}}" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Classes="muted" Text="{Binding Converter={x:Static v:Converters.InstanceSummary}}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,12,*">
            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,12"
                    Content="{loc:T 'Manage all profiles'}" Command="{Binding ManageInstancesCommand}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,12"
                    Content="{loc:T '+ Add mods'}" Command="{Binding AddModsCommand}" />
          </Grid>
          <Expander Header="{loc:T 'Game output'}" HorizontalAlignment="Stretch">
            <ListBox ItemsSource="{Binding GameLog}" Background="Transparent" MaxHeight="260" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="l:GameLogLine">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>
          <Expander Header="{loc:T 'Recent activity'}" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding Activity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="d:ActivityEntry">
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Message, Converter={x:Static v:Converters.Translate}}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding TimestampUtc, Converter={x:Static v:Converters.LocalTime}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>

        <!-- Bedrock: the two official builds -->
        <StackPanel Spacing="10" IsVisible="{Binding IsBedrock}">
          <TextBlock Classes="h2" Text="{loc:T 'Minecraft Bedrock'}" />
          <ItemsControl ItemsSource="{Binding Bedrock}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:BedrockEntry">
                <Border Classes="card" Padding="14" Margin="0,0,0,8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Classes="accent" Content="{loc:T '▶ Play'}" Padding="22,8" IsVisible="{Binding IsInstalled}"
                              Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PlayBedrockCommand}" CommandParameter="{Binding}" />
                      <Button Content="{loc:T 'Install'}" Padding="22,8" IsVisible="{Binding CanInstall}"
                              ToolTip.Tip="{loc:T 'Opens the Microsoft Store, which checks that your account owns the game.'}"
                              Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).InstallBedrockCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Classes="muted" Text="{Binding Status}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" FontSize="12"
                     Text="{loc:T 'Bedrock is installed and licensed by Microsoft. Launchers can’t download it themselves because its files are protected; your skin and cape for Bedrock are changed in the game.'}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- News from minecraft.net -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="card" Padding="14">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{loc:T 'Latest news'}" Margin="4,0,0,10" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding NewsStatus}" Margin="4,0,0,8" IsVisible="{Binding NewsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding News}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="n:NewsItem">
                <Button Classes="news" Margin="0,0,0,10" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenNewsCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{loc:T 'Read on minecraft.net'}">
                  <StackPanel Spacing="6">
                    <Border CornerRadius="10" ClipToBounds="True" Height="148" Background="{DynamicResource NinjaSurfaceRaised}">
                      <Image c:RemoteImage.Url="{Binding ImageUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="4,0,4,6" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" FontSize="11" Text="{Binding Date, Converter={x:Static v:Converters.LongDate}}" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding Text}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Background dialog -->
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#99000000" IsVisible="{Binding IsBackgroundDialogOpen}">
      <Border Classes="card" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="14">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseBackgroundDialogCommand}" AutomationProperties.Name="{loc:T 'Close'}" />
            <TextBlock Classes="h2" Text="{loc:T 'Home background image'}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="muted" Text="{loc:T 'PNG or JPEG. It fills the card behind your character; recommended 1600 × 600 px. Maximum: 4096 px per side and 16 MB.'}" />
          <Grid ColumnDefinitions="*,12,*">
            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,12"
                    Content="{loc:T 'Upload background'}" Command="{Binding UploadBackgroundCommand}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,12"
                    Content="{loc:T 'Restore default background'}" Command="{Binding RestoreBackgroundCommand}" IsEnabled="{Binding HasCustomBackground}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
