<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NinjaLauncher.Desktop.Localization"
             xmlns:vm="using:NinjaLauncher.Desktop.ViewModels"
             xmlns:d="using:NinjaLauncher.Domain"
             xmlns:l="using:NinjaLauncher.Minecraft.Java.Launch"
             xmlns:v="using:NinjaLauncher.Desktop.Views"
             xmlns:c="using:NinjaLauncher.Desktop.Controls"
             x:Class="NinjaLauncher.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel" Classes="page">
  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,320">
    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
      <Border DockPanel.Dock="Right" Classes="card" Padding="12,8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Width="14" Height="14" Foreground="{DynamicResource NinjaAccentBrush}" />
          <TextBlock Text="{Binding AccountText}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <StackPanel>
        <TextBlock Classes="h1" Text="{loc:T 'Welcome back'}" />
        <TextBlock Classes="muted" Text="{loc:T 'Pick an edition and an instance, then hit Play.'}" />
      </StackPanel>
    </DockPanel>

    <!-- Hero -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="18" Padding="28" Margin="0,0,0,18" ClipToBounds="True">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#3B1670" />
          <GradientStop Offset="0.6" Color="#5B1F7A" />
          <GradientStop Offset="1" Color="#9D1F6B" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="18">
            <RadioButton GroupName="edition" Content="{loc:T 'Java Edition'}" IsChecked="{Binding IsJava}" Foreground="White" FontWeight="SemiBold" />
            <RadioButton GroupName="edition" Content="{loc:T 'Bedrock Edition'}" IsChecked="{Binding IsBedrock, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding IsJava}">
            <TextBlock Text="{loc:T 'INSTANCE'}" FontSize="11" FontWeight="Bold" LetterSpacing="2" Foreground="#E9D5FF" />
            <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" MinWidth="320" PlaceholderText="{loc:T 'No instances yet'}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="d:GameInstance">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Width="20" Height="20" c:RemoteImage.Url="{Binding Converter={x:Static v:Converters.InstanceIcon}}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding SelectedSummary}" Foreground="#F3E8FF" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding IsBedrock}" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="{loc:T 'MINECRAFT BEDROCK'}" FontSize="11" FontWeight="Bold" LetterSpacing="2" Foreground="#E9D5FF" />
            <TextBlock Text="{Binding BedrockText}" Foreground="#F3E8FF" TextWrapping="Wrap" />
            <Button Content="{loc:T 'Open Bedrock data folder'}" Command="{Binding OpenBedrockDataCommand}" IsVisible="{Binding HasBedrockData}" />
            <Button Classes="accent" Content="{loc:T 'Get Minecraft for Windows (Microsoft Store)'}" Command="{Binding GetBedrockCommand}" IsVisible="{Binding CanGetBedrock}" />
            <TextBlock Foreground="#E9D5FF" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding CanGetBedrock}"
                       Text="{loc:T 'Bedrock is sold and installed by Microsoft through the Store or the Xbox app; its files are protected, so launchers can’t download it. After installing it there, come back and press Play.'}" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Classes="play" Content="{loc:T 'PLAY'}" Command="{Binding PlayCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Game log -->
    <Border Grid.Row="2" Classes="card" Margin="0,0,18,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{loc:T 'Game output'}" Margin="0,0,0,10" />
        <ListBox ItemsSource="{Binding GameLog}" Background="Transparent" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="l:GameLogLine">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Activity -->
    <Border Grid.Row="2" Grid.Column="1" Classes="card">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{loc:T 'Recent activity'}" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Activity}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="d:ActivityEntry">
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="11" Text="{Binding TimestampUtc, Converter={x:Static v:Converters.LocalTime}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
