<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NinjaLauncher.Desktop.ViewModels"
             xmlns:d="using:NinjaLauncher.Domain"
                          xmlns:c="using:NinjaLauncher.Desktop.Controls"
             x:Class="NinjaLauncher.Desktop.Views.DiscoverView"
             x:DataType="vm:DiscoverViewModel" Classes="page">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Classes="h1" Text="Discover" />
      <TextBlock Classes="muted" Text="Mods, modpacks, shaders and resource packs from Modrinth and CurseForge." />
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="card" Padding="14" Margin="0,0,0,12">
      <StackPanel Spacing="10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="accent" Content="Search" Command="{Binding SearchCommand}" Margin="10,0,0,0" IsDefault="True" />
          <TextBox Text="{Binding Query}" PlaceholderText="Search…" />
        </DockPanel>
        <WrapPanel>
          <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" MinWidth="140" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" MinWidth="150" Margin="0,0,12,0" />
          <StackPanel Orientation="Horizontal" IsVisible="{Binding NeedsTarget}">
            <TextBlock Text="Install into" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding Target}" MinWidth="220" PlaceholderText="No instances" Margin="0,0,12,0">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="d:GameInstance">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="Only compatible with this instance" IsChecked="{Binding FilterByInstance}" />
          </StackPanel>
          <TextBlock Classes="muted" Text="Installing a modpack creates a new instance." VerticalAlignment="Center" IsVisible="{Binding !NeedsTarget}" />
        </WrapPanel>
        <TextBlock Classes="muted" FontSize="12" Text="{Binding Warning}" />
      </StackPanel>
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="‹ Previous" Command="{Binding PreviousPageCommand}" />
        <Button Content="Next ›" Command="{Binding NextPageCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ContentHit">
            <Border Classes="card" Padding="14" Margin="0,0,0,8">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="Details" Command="{Binding $parent[UserControl].((vm:DiscoverViewModel)DataContext).OpenPageCommand}" CommandParameter="{Binding}" />
                  <Button Classes="accent" Content="Install" Command="{Binding $parent[UserControl].((vm:DiscoverViewModel)DataContext).InstallCommand}" CommandParameter="{Binding}" />
                </StackPanel>
                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="10" ClipToBounds="True" Margin="0,0,14,0"
                        Background="{DynamicResource NinjaSurfaceRaised}" VerticalAlignment="Top">
                  <Image c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Border>
                <StackPanel Spacing="3" Margin="0,0,12,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Author, StringFormat='by {0}'}" VerticalAlignment="Bottom" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{Binding Description}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource NinjaAccentBrush}" Text="{Binding Downloads, StringFormat='{}{0:N0} downloads'}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
