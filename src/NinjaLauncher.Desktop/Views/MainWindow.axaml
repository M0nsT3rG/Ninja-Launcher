<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:NinjaLauncher.Desktop.Localization"
        xmlns:vm="using:NinjaLauncher.Desktop.ViewModels"
        xmlns:v="using:NinjaLauncher.Desktop.Views"
        x:Class="NinjaLauncher.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ninja-launcher.ico"
        Title="Ninja Launcher"
        Width="1240" Height="780" MinWidth="960" MinHeight="620"
        Background="{DynamicResource NinjaBackground}">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><v:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:LibraryViewModel"><v:LibraryView /></DataTemplate>
    <DataTemplate DataType="vm:DiscoverViewModel"><v:DiscoverView /></DataTemplate>
    <DataTemplate DataType="vm:WardrobeViewModel"><v:WardrobeView /></DataTemplate>
    <DataTemplate DataType="vm:DownloadsViewModel"><v:DownloadsView /></DataTemplate>
    <DataTemplate DataType="vm:AccountsViewModel"><v:AccountsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Window.DataTemplates>
  <Window.Styles>
    <Style Selector="ListBox.rail">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem" x:DataType="vm:NavItem">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.Tip" Value="{Binding Title}" />
      <Setter Property="ToolTip.Placement" Value="Right" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NinjaSurfaceRaised}" />
    </Style>
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.Placement" Value="Right" />
    </Style>
    <!-- Icon colours come from styles (a colour set on the icon itself would win over them); later styles override earlier ones. -->
    <Style Selector="ListBox.rail PathIcon, Button.rail.settings PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource NinjaMuted}" />
    </Style>
    <Style Selector="Button.rail.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NinjaSurfaceRaised}" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem:selected PathIcon, Button.rail.active PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource NinjaAccentBrush}" />
    </Style>
    <Style Selector="TabStrip.big TabStripItem">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="0,4,28,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TabStrip.big Border.pipe">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="TabStrip.big TabStripItem:selected Border.pipe">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TabStrip.big TabStripItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The theme's spinner buttons only hold an icon, so screen readers would read the icon's class name. -->
    <Style Selector="ButtonSpinner /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="AutomationProperties.Name" Value="{l:T 'Increase'}" />
    </Style>
    <Style Selector="ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="AutomationProperties.Name" Value="{l:T 'Decrease'}" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="76,*">
    <!-- Icon rail: every icon has its name as a tooltip and for screen readers. -->
    <Border Background="{DynamicResource NinjaSidebar}" BorderBrush="{DynamicResource NinjaBorder}" BorderThickness="0,0,1,0">
      <DockPanel Margin="0,16">
        <Image DockPanel.Dock="Top" Source="/Assets/ninja-launcher.png" Width="44" Height="44" Margin="0,0,0,18"
               RenderOptions.BitmapInterpolationMode="HighQuality" ToolTip.Tip="Ninja Launcher" />
        <Button DockPanel.Dock="Bottom" Classes="rail" Margin="0,6,0,0" Command="{Binding PlayLatestCommand}" HorizontalAlignment="Center"
                Background="{DynamicResource NinjaGradient}" ToolTip.Tip="{l:T 'Play your latest profile'}" AutomationProperties.Name="{l:T 'Play your latest profile'}">
          <PathIcon Width="20" Height="20" Foreground="White" Data="M8,5.14V19.14L19,12.14L8,5.14Z" />
        </Button>
        <Button DockPanel.Dock="Bottom" Classes="rail settings" Classes.active="{Binding IsSettingsOpen}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Center"
                ToolTip.Tip="{l:T 'Settings'}" AutomationProperties.Name="{l:T 'Settings'}">
          <PathIcon Width="22" Height="22" Data="{Binding Navigation[6].Icon, Converter={x:Static v:Converters.Geometry}}" />
        </Button>
        <ListBox Classes="rail" ItemsSource="{Binding RailItems}" SelectedItem="{Binding RailSelection}" HorizontalAlignment="Center">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NavItem">
              <PathIcon Data="{Binding Icon, Converter={x:Static v:Converters.Geometry}}" Width="22" Height="22" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page, with the disclaimer Minecraft's usage guidelines ask for always in view -->
    <DockPanel Grid.Column="1" Margin="28,24,28,8">
      <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Right"
                 Text="{l:T 'Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.'}" />
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

    <!-- Toast -->
    <Border Grid.Column="1" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" MaxWidth="520"
            Background="{DynamicResource NinjaToastBg}" BorderBrush="{DynamicResource NinjaAccentBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12"
            Classes.error="{Binding ToastIsError}">
      <Border.Styles>
        <Style Selector="Border.error"><Setter Property="BorderBrush" Value="{DynamicResource NinjaDanger}" /></Style>
      </Border.Styles>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissToastCommand}" Background="Transparent" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Top" />
        <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- Confirmation -->
    <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsConfirmOpen}" Background="#99000000">
      <Border Classes="card" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="18">
          <TextBlock Classes="h2" Text="{l:T 'Are you sure?'}" />
          <ScrollViewer MaxHeight="380">
            <SelectableTextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{l:T 'Cancel'}" Command="{Binding AnswerCommand}" CommandParameter="no" IsCancel="True" />
            <Button Classes="accent" Content="{l:T 'Continue'}" Command="{Binding AnswerCommand}" CommandParameter="yes" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
