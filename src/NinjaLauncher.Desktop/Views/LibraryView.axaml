<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NinjaLauncher.Desktop.ViewModels"
             xmlns:d="using:NinjaLauncher.Domain"
             xmlns:v="using:NinjaLauncher.Desktop.Views"
             xmlns:m="using:NinjaLauncher.Mods.Modrinth"
             xmlns:c="using:NinjaLauncher.Desktop.Controls"
             xmlns:diag="using:NinjaLauncher.Minecraft.Java.Diagnostics"
             x:Class="NinjaLauncher.Desktop.Views.LibraryView"
             x:DataType="vm:LibraryViewModel" Classes="page">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="340,*">
    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Import config" Command="{Binding ImportConfigCommand}" ToolTip.Tip="Create an instance from an exported .ninja.json" />
        <Button Content="Import modpack" Command="{Binding ImportModpackCommand}" ToolTip.Tip="Modrinth .mrpack or CurseForge .zip" />
        <Button Classes="accent" Content="+ New instance" Command="{Binding StartCreateCommand}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="h1" Text="Library" />
        <TextBlock Classes="muted" Text="Every instance is isolated: its own worlds, mods, options and logs." />
      </StackPanel>
    </DockPanel>

    <!-- Instance list -->
    <Border Grid.Row="1" Classes="card" Margin="0,0,18,0" Padding="12">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Text="{Binding Search}" PlaceholderText="Search instances" Margin="0,0,0,10" />
        <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="d:GameInstance">
              <DockPanel Margin="2,4">
                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0" Background="{DynamicResource NinjaSurfaceRaised}">
                  <Image c:RemoteImage.Url="{Binding Converter={x:Static v:Converters.InstanceIcon}}" Stretch="UniformToFill" />
                </Border>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding MinecraftVersion}" />
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding Loader}" />
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding LoaderVersion}" />
                </StackPanel>
              </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Create form -->
    <Border Grid.Row="1" Grid.Column="1" Classes="card" IsVisible="{Binding IsCreating}">
      <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
          <TextBlock Classes="h2" Text="New instance" />
          <TextBlock Text="Name" />
          <TextBox Text="{Binding NewName}" PlaceholderText="My survival world" MaxLength="64" />
          <TextBlock Text="Minecraft version" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding NewVersion}" MinWidth="220" MaxDropDownHeight="360" />
            <CheckBox Content="Show snapshots" IsChecked="{Binding ShowSnapshots}" />
          </StackPanel>
          <TextBlock Text="Mod loader" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox ItemsSource="{Binding LoaderKinds}" SelectedItem="{Binding NewLoader}" MinWidth="140" />
            <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding NewLoaderVersion}" MinWidth="220" MaxDropDownHeight="360"
                      PlaceholderText="Loader version" IsVisible="{Binding LoaderVersions.Count}" />
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding LoadingLoaderVersions}" />
          </StackPanel>
          <TextBlock Text="Maximum memory (MB)" />
          <NumericUpDown Value="{Binding NewMemoryMb}" Minimum="512" Maximum="65536" Increment="512" FormatString="0" Width="180" HorizontalAlignment="Left" />
          <TextBlock Classes="muted" FontSize="12" Text="Forge and NeoForge are installed by running their official installers, which can take a few minutes." />
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
            <Button Classes="accent" Content="Create" Command="{Binding CreateCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCreateCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Details -->
    <Border Grid.Row="1" Grid.Column="1" Classes="card" IsVisible="{Binding !IsCreating}">
      <Panel>
        <TextBlock Classes="muted" Text="Select an instance, or create one with “New instance”." IsVisible="{Binding !HasSelection}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding DiskUsage}" VerticalAlignment="Center" />
              <TextBlock Classes="h2" Text="{Binding Selected.Name, FallbackValue=''}" />
            </DockPanel>
            <WrapPanel>
              <Button Classes="accent" Content="▶ Launch" Command="{Binding LaunchCommand}" Margin="0,0,8,8" />
              <Button Content="Repair" Command="{Binding RepairCommand}" Margin="0,0,8,8" ToolTip.Tip="Re-verify every file by hash and re-download anything broken" />
              <Button Content="Clone" Command="{Binding CloneCommand}" Margin="0,0,8,8" />
              <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8" />
              <Button Content="Export config" Command="{Binding ExportConfigCommand}" Margin="0,0,8,8" />
              <Button Content="Export for Modrinth" Command="{Binding ExportModpackCommand}" Margin="0,0,8,8" ToolTip.Tip="Share this instance as a Modrinth modpack (.mrpack). Worlds and personal settings are not included." />
              <Button Content="Export for CurseForge" Command="{Binding ExportCurseForgeCommand}" Margin="0,0,8,8" ToolTip.Tip="Share this instance as a CurseForge modpack (.zip). Worlds and personal settings are not included." />
              <Button Content="Change icon" Command="{Binding ChangeIconCommand}" Margin="0,0,8,8" />
              <Button Content="Reset icon" Command="{Binding ResetIconCommand}" Margin="0,0,8,8" IsVisible="{Binding Selected.IconKey, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
              <Button Classes="danger" Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock Text="Settings" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Name" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding EditName}" MaxLength="64" />
              <TextBlock Grid.Row="1" Text="Memory (MB)" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <NumericUpDown Value="{Binding EditMinMemory}" Minimum="256" Maximum="65536" Increment="256" FormatString="0" Width="150" ToolTip.Tip="Minimum (-Xms)" />
                <NumericUpDown Value="{Binding EditMaxMemory}" Minimum="512" Maximum="65536" Increment="512" FormatString="0" Width="150" ToolTip.Tip="Maximum (-Xmx)" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="JVM arguments" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditJvmArgs}" PlaceholderText="Empty = recommended defaults from the version" />
              <TextBlock Grid.Row="3" Text="Java executable" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditJavaPath}" PlaceholderText="Empty = managed Java chosen for this version" />
              <Button Grid.Row="4" Grid.Column="1" Content="Save settings" Command="{Binding SaveCommand}" />
            </Grid>

            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding CheckingUpdates}" />
                <Button Content="Check for updates" Command="{Binding CheckModUpdatesCommand}" IsVisible="{Binding Mods.Count}" />
                <Button Classes="accent" Content="{Binding UpdateCount, StringFormat='Update {0}'}" Command="{Binding UpdateModsCommand}" IsVisible="{Binding UpdateCount}" />
              </StackPanel>
              <TextBlock Text="Mods" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="muted" Text="No mods installed. Find some on the Discover page." IsVisible="{Binding !Mods.Count}" />
            <ItemsControl ItemsSource="{Binding Mods}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ModEntry">
                  <DockPanel Margin="0,2">
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Enabled, Mode=OneWay}" OnContent="On" OffContent="Off"
                                  Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ToggleModCommand}" CommandParameter="{Binding}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateText}" IsVisible="{Binding HasUpdate}" Foreground="{DynamicResource NinjaAccentBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6" ClipToBounds="True" Margin="0,0,10,0" Background="{DynamicResource NinjaSurfaceRaised}">
                      <Image c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding CheckingCompatibility}" />
                <Button Content="Check compatibility" Command="{Binding CheckCompatibilityCommand}" IsVisible="{Binding Mods.Count}" />
                <Button Classes="accent" Content="Install missing dependencies" Command="{Binding InstallMissingDependenciesCommand}" IsVisible="{Binding HasMissingDependencies}" />
              </StackPanel>
              <TextBlock Text="Compatibility" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="muted" Text="{Binding CompatibilityStatus}" IsVisible="{Binding CompatibilityStatus.Length}" />
            <ItemsControl ItemsSource="{Binding Issues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="m:ModIssue">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Width="64" Classes.error="{Binding Severity, Converter={x:Static v:Converters.IsError}}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="640" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.Styles>
                <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource NinjaDanger}" /></Style>
              </ItemsControl.Styles>
            </ItemsControl>

            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Open crash folder" Command="{Binding OpenCrashFolderCommand}" IsVisible="{Binding CrashFiles.Count}" />
              <TextBlock Text="Crash reports" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="muted" Text="No crashes recorded for this instance." IsVisible="{Binding !CrashFiles.Count}" />
            <ComboBox ItemsSource="{Binding CrashFiles}" SelectedItem="{Binding SelectedCrash}" MinWidth="360" IsVisible="{Binding CrashFiles.Count}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="diag:CrashFile">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Classes="card" Padding="12" IsVisible="{Binding Crash, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource NinjaSurfaceRaised}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Crash.Title, FallbackValue=''}" FontWeight="SemiBold" Foreground="{DynamicResource NinjaDanger}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding Crash.Exception, FallbackValue=''}" TextWrapping="Wrap" FontSize="12" />
                <SelectableTextBlock Text="{Binding Crash.RootCause, StringFormat='Root cause: {0}', FallbackValue=''}" TextWrapping="Wrap" FontSize="12"
                                     IsVisible="{Binding Crash.RootCause, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                <TextBlock Text="{Binding Crash.SuspectedMods, Converter={x:Static v:Converters.JoinLines}, StringFormat='Suspected mods: {0}', FallbackValue=''}"
                           TextWrapping="Wrap" FontSize="12" IsVisible="{Binding Crash.SuspectedMods.Count, FallbackValue=False}" />
                <TextBlock Text="{Binding Crash.Hint, FallbackValue=''}" TextWrapping="Wrap" Foreground="{DynamicResource NinjaAccentBrush}"
                           IsVisible="{Binding Crash.Hint, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
              </StackPanel>
            </Border>
            <TextBox Text="{Binding CrashText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="220"
                     FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="11" IsVisible="{Binding HasCrash}" />

            <TextBlock Text="World backups" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding SelectedWorld}" PlaceholderText="World" MinWidth="220" />
              <Button Content="Back up" Command="{Binding BackupWorldCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" PlaceholderText="Backup" MinWidth="320">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding Converter={x:Static v:Converters.FileName}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Restore" Command="{Binding RestoreBackupCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
