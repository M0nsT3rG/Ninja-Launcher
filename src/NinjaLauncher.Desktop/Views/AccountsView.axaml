<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:NinjaLauncher.Desktop.Localization"
             xmlns:vm="using:NinjaLauncher.Desktop.ViewModels"
             xmlns:d="using:NinjaLauncher.Domain"
             x:Class="NinjaLauncher.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel" Classes="page">
  <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
    <StackPanel>
      <TextBlock Classes="h1" Text="{l:T 'Accounts'}" />
      <TextBlock Classes="muted" Text="{l:T 'Sign in with Microsoft in your browser. Ninja Launcher never sees your password.'}" />
    </StackPanel>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="accent" Content="{l:T 'Sign in with Microsoft'}" Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}" />
          <ProgressBar IsIndeterminate="True" Width="100" IsVisible="{Binding IsSigningIn}" />
          <TextBlock Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding SignInUnavailableReason}" IsVisible="{Binding !CanSignIn}" Foreground="{DynamicResource NinjaDanger}" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding StorageText}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'Offline profile'}" />
        <TextBlock Classes="muted" Text="{Binding OfflineLockedText}" IsVisible="{Binding !CanUseOffline}" />
        <StackPanel Spacing="10" IsVisible="{Binding CanUseOffline}">
          <TextBlock Classes="muted" Text="{Binding OfflineInfoText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding OfflineName}" PlaceholderText="{l:T 'Player name'}" MaxLength="16" Width="220" />
            <Button Content="{l:T 'Add offline profile'}" Command="{Binding AddOfflineCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Accounts}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="d:MinecraftAccount">
          <Border Classes="card" Padding="14" Margin="0,0,0,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="{l:T 'Use this account'}" IsVisible="{Binding !IsActive}"
                        Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).MakeActiveCommand}" CommandParameter="{Binding}" />
                <Button Classes="danger" Content="{l:T 'Remove'}"
                        Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource NinjaGradient}">
                  <TextBlock Text="{Binding Username, Converter={x:Static vm:AccountsDisplay.Initial}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Kind}" />
                    <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Active'}" IsVisible="{Binding IsActive}" Foreground="{DynamicResource NinjaAccentBrush}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
